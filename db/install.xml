<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/targetzenit/db" VERSION="20261029" COMMENT="Target Zenit integration tables"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_targetzenit_timetable" COMMENT="Frappe'dan kelgan dars jadvali. Har push'da butunlay almashtiriladi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="academicyear" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false" COMMENT="2026-2027"/>
        <FIELD NAME="groupkey" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Frappe Student Group docname"/>
        <FIELD NAME="groupname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="subjectkey" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="subjectname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="teacherkey" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Employee ID yoki INSTR-&lt;ism&gt;"/>
        <FIELD NAME="teachername" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="dayno" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1=Dushanba ... 5=Juma"/>
        <FIELD NAME="dayname" TYPE="char" LENGTH="50" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="lessonno" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="starttime" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endtime" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="room" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="courseidnumber" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle kursining idnumber'i"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="year_group" UNIQUE="false" FIELDS="academicyear, groupkey"/>
        <INDEX NAME="year_teacher" UNIQUE="false" FIELDS="academicyear, teacherkey"/>
        <INDEX NAME="dayno" UNIQUE="false" FIELDS="dayno"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_calendar" COMMENT="O'quv kalendari: chorak oraliqlari va bayramlar (Frappe'dan).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="academicyear" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="entrytype" TYPE="char" LENGTH="20" NOTNULL="true" SEQUENCE="false" COMMENT="term | holiday"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="startdate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="enddate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="year_type" UNIQUE="false" FIELDS="academicyear, entrytype"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_lesson" COMMENT="O'tkazilgan dars: mavzu va uy vazifa. Har (kurs + sana + dars raqami) uchun bitta.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="lessondate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="lessonno" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="topic" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Dars mavzusi"/>
        <FIELD NAME="homework" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Uy vazifa"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Kim yozdi"/>
        <FIELD NAME="gradeitemid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Moodle gradebook'dagi baho ustuni"/>
        <FIELD NAME="assigncmid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Uy vazifa uchun yaratilgan mod_assign (course module id)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_date_lesson" UNIQUE="true" FIELDS="courseid, lessondate, lessonno"/>
        <INDEX NAME="lessondate" UNIQUE="false" FIELDS="lessondate"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_record" COMMENT="O'quvchining shu darsdagi davomati va bahosi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="lessonid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="attendance" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="present" SEQUENCE="false" COMMENT="present|absent|late|excused"/>
        <FIELD NAME="grade" TYPE="int" LENGTH="3" NOTNULL="false" SEQUENCE="false" COMMENT="1-10, bo'sh bo'lishi mumkin"/>
        <FIELD NAME="comment" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="lesson_user" UNIQUE="true" FIELDS="lessonid, userid"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_audio" COMMENT="Dars audio yozuvi. Audio VAQTINCHALIK — transkriptdan keyin yoki muddat o'tgach o'chadi, matn qoladi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="lessonid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="recording" SEQUENCE="false" COMMENT="recording|ready|transcribed|deleted|failed"/>
        <FIELD NAME="filename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="filesize" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="soniya"/>
        <FIELD NAME="mimetype" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="transcript" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="AI transkripti — audio o'chgandan keyin ham qoladi"/>
        <FIELD NAME="analysis" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="AI tahlili (JSON): xulosa, mavzuga muvofiqlik, tuzilish, nutq ulushi"/>
        <FIELD NAME="aimodel" TYPE="char" LENGTH="64" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="aierror" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="analysedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="lessonid" UNIQUE="true" FIELDS="lessonid"/>
        <INDEX NAME="status_time" UNIQUE="false" FIELDS="status, timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_payroll" COMMENT="Frappe oylik tabelidan kelgan xodim oyligi. Frappe YAGONA MANBA — bu yerda faqat ko'rsatish uchun nusxa, Moodle hech narsa hisoblamaydi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="useridnumber" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Frappe Employee.name — Moodle user.idnumber bilan bog'lanadi"/>
        <FIELD NAME="employeename" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="yil" TYPE="int" LENGTH="4" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="oy" TYPE="int" LENGTH="2" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="lavozim" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="tolovturi" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="kun" SEQUENCE="false" COMMENT="kun = kunbay, soat = soatbay"/>
        <FIELD NAME="normakun" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Shu oydagi norma ish kuni"/>
        <FIELD NAME="kelgankun" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="ishlagan" TYPE="number" LENGTH="10" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Kunbayda koeffitsient yig'indisi, soatbayda ishlagan soat"/>
        <FIELD NAME="kunliknarx" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="oylik" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Shartnoma oyligi (soatbayda — 1 soat narxi)"/>
        <FIELD NAME="bonus" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Bonus musbat, jarima manfiy — Frappe'da allaqachon qo'shilgan"/>
        <FIELD NAME="nalog" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="pitaniya" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="hisob" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Hisoblangan ish haqi (ushlovlardan oldin)"/>
        <FIELD NAME="jami" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Qo'lga tegadigan summa"/>
        <FIELD NAME="valyuta" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="holat" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="Ochiq" SEQUENCE="false" COMMENT="Ochiq = oy davom etmoqda, Yopiq = yakunlangan"/>
        <FIELD NAME="kunlarjson" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Kunlar: [{kun, koef, kirish, chiqish}] — kirish/chiqish Face ID turniketdan"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ref_oy" UNIQUE="true" FIELDS="useridnumber, yil, oy"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_settle" COMMENT="Xodim bilan hisob-kitob: oy kesimida nachisleniya / to'langan / qoldiq. Frappe'dagi investor paneli bilan BIR XIL manbadan keladi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="useridnumber" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Frappe Employee.name"/>
        <FIELD NAME="oy" TYPE="char" LENGTH="7" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM"/>
        <FIELD NAME="valyuta" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="UZS" SEQUENCE="false"/>
        <FIELD NAME="oylik" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Shu oy uchun belgilangan ish haqi"/>
        <FIELD NAME="nach" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Nachisleniya — hisoblangan"/>
        <FIELD NAME="paid" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="To'langan"/>
        <FIELD NAME="advance" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Shundan nachisleniyaga bog'lanmagan (avans)"/>
        <FIELD NAME="debt" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Qoldiq: musbat = to'lanmagan, manfiy = ortiq to'langan"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Yurish belgisi (runid) — ortiqcha qatorlarni topish uchun"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ref_oy_cur" UNIQUE="true" FIELDS="useridnumber, oy, valyuta"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_settle" COMMENT="Xodim bilan hisob-kitob: oy kesimida nachisleniya / to'langan / qoldiq. Frappe'dan.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="useridnumber" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="oy" TYPE="char" LENGTH="7" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM"/>
        <FIELD NAME="valyuta" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="UZS" SEQUENCE="false"/>
        <FIELD NAME="oylik" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="nach" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="paid" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="advance" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="debt" TYPE="number" LENGTH="15" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="ref_oy_cur" UNIQUE="true" FIELDS="useridnumber, oy, valyuta"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_staff" COMMENT="O'qituvchi o'lchovi va kalit ko'prigi: _timetable.teacherkey (Employee ID = user.idnumber) va Moodle user.id.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="academicyear" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="teacherkey" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Frappe Employee.name — yagona haqiqiy kalit"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="user.idnumber = teacherkey orqali topilgan"/>
        <FIELD NAME="teachername" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="FAQAT ko'rsatish va diagnostika uchun — bog'lash uchun ishlatilmaydi"/>
        <FIELD NAME="holat" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="ok" SEQUENCE="false" COMMENT="ok | userless | legacykey"/>
        <FIELD NAME="lessonsweek" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="subjects" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="year_key" UNIQUE="true" FIELDS="academicyear, teacherkey"/>
        <INDEX NAME="userid" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="holat" UNIQUE="false" FIELDS="holat"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_slot" COMMENT="Rejalashtirilgan dars o'rni — jadval va kalendardan materiallashtirilgan. O'tgan sanalar frozen=1, qayta qurilmaydi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="slotkey" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="md5(yil|sana|dars|guruh|fan) — tabiiy kalit CHAR ustunlari uzun bo'lgani uchun"/>
        <FIELD NAME="academicyear" TYPE="char" LENGTH="50" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="lessondate" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="YYYY-MM-DD"/>
        <FIELD NAME="dayno" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lessonno" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="termname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="groupkey" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="groupname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="subjectkey" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="subjectname" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="teacherkey" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="REJADAGI o'qituvchi"/>
        <FIELD NAME="teacheruserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="courseidnumber" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="starttime" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="endtime" TYPE="char" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="room" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="frozen" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 = o'tmish, qayta qurilmaydi"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="slotkey" UNIQUE="true" FIELDS="slotkey"/>
        <INDEX NAME="date_teacher" UNIQUE="false" FIELDS="lessondate, teacheruserid"/>
        <INDEX NAME="teacher_date" UNIQUE="false" FIELDS="teacheruserid, lessondate"/>
        <INDEX NAME="course_date" UNIQUE="false" FIELDS="courseid, lessondate"/>
        <INDEX NAME="year_date" UNIQUE="false" FIELDS="academicyear, lessondate"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_targetzenit_fact" COMMENT="Reja va fakt taqqoslashi, slot bilan 1:1. Sana oraligi bo'yicha idempotent qayta hisoblanadi.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="slotid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="lessonid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="writeruserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Haqiqatda yozgan odam"/>
        <FIELD NAME="attributeduserid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Hisobot kimga yoziladi: yozgan odam, u yo'q bo'lsa rejadagi"/>
        <FIELD NAME="substituted" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="hastopic" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="hashomework" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="studentcount" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="attendancecount" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="gradecount" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="absentcount" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="latecount" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="audiostatus" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
        <FIELD NAME="audioseconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="analysestatus" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false" COMMENT="none|pending|ok|failed"/>
        <FIELD NAME="analysedat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="JSON ni qayta o'qish kerakmi — shuni aniqlash uchun"/>
        <FIELD NAME="overallscore" TYPE="int" LENGTH="4" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="normdelta" TYPE="int" LENGTH="4" NOTNULL="false" SEQUENCE="false" COMMENT="overallscore minus xalqaro o'rtacha; saralash uchun"/>
        <FIELD NAME="lowconfcount" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="lastwriteat" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="latehours" TYPE="int" LENGTH="4" NOTNULL="false" SEQUENCE="false" COMMENT="Jurnal dars tugagandan keyin qancha soat o'tib to'ldirildi"/>
        <FIELD NAME="feedbackcount" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="slotid" UNIQUE="true" FIELDS="slotid"/>
