{{!
    @template local_targetzenit/mobile_cockpit

    Dars kokpiti — yo'qlama va baho (mobil ilova).

    YOZISH: har tugma `core-site-plugins-call-ws` orqali
    `local_targetzenit_mobile_save_record` ni chaqiradi.

    Yo'qlama BITTA BOSISHDA saqlanadi — dars paytida eng tez-tez
    qilinadigan amal, shuning uchun alohida "saqlash" bosqichi yo'q.
    Baho esa kiritilib, yonidagi tugma bilan saqlanadi.

    Context variables required for this template:
    * ruxsat - dars o'tish huquqi bormi
    * xabar - bo'lmasa sabab
    * kurs, sana, lessonno, lessonid, maxgrade
    * oquvchilar - [{userid, ism, baho, keldi, kelmadi, kechikdi, sababli}]

    Example context (json):
    {
        "ruxsat": true, "xabar": "", "kurs": "8 A(full) — ROBOTICS",
        "sana": "3 November 2026", "lessonno": 2, "lessonid": 41,
        "maxgrade": 10,
        "oquvchilar": [{"userid": 120, "ism": "Ali Valiyev", "baho": "9",
                        "keldi": true, "kelmadi": false,
                        "kechikdi": false, "sababli": false}]
    }
}}
<ion-card>
    <ion-card-header>
        <ion-card-title>{{ kurs }}</ion-card-title>
        <ion-card-subtitle>
            {{#str}}app_lesson, local_targetzenit{{/str}} {{ lessonno }} · {{ sana }}
        </ion-card-subtitle>
    </ion-card-header>
    {{# ruxsat }}
    <ion-card-content>
        <p>{{#str}}app_attendancehint, local_targetzenit{{/str}}</p>
        <p>{{#str}}app_lessonsaved, local_targetzenit{{/str}}</p>
    </ion-card-content>
    {{/ ruxsat }}
</ion-card>

{{^ ruxsat }}
    <ion-card color="warning">
        <ion-card-content><p>{{ xabar }}</p></ion-card-content>
    </ion-card>
{{/ ruxsat }}

{{# ruxsat }}
<ion-list>
    {{# oquvchilar }}
    <ion-item-divider>
        <ion-label class="ion-text-wrap">{{ ism }}</ion-label>
    </ion-item-divider>

    <ion-item lines="none">
        <div class="ion-text-wrap" style="display:flex;flex-wrap:wrap;gap:4px;width:100%">
            <ion-button size="small"
                        fill="{{# keldi }}solid{{/ keldi }}{{^ keldi }}outline{{/ keldi }}"
                        core-site-plugins-call-ws
                        name="local_targetzenit_mobile_save_record"
                        [params]="{lessonid: {{ lessonid }}, userid: {{ userid }}, attendance: 'present', grade: CONTENT_OTHERDATA.gr_{{ userid }}}"
                        [preSets]="{typeExpected: 'object'}"
                        refreshOnSuccess="true">
                {{#str}}att_present, local_targetzenit{{/str}}
            </ion-button>
            <ion-button size="small" color="danger"
                        fill="{{# kelmadi }}solid{{/ kelmadi }}{{^ kelmadi }}outline{{/ kelmadi }}"
                        core-site-plugins-call-ws
                        name="local_targetzenit_mobile_save_record"
                        [params]="{lessonid: {{ lessonid }}, userid: {{ userid }}, attendance: 'absent', grade: CONTENT_OTHERDATA.gr_{{ userid }}}"
                        [preSets]="{typeExpected: 'object'}"
                        refreshOnSuccess="true">
                {{#str}}att_absent, local_targetzenit{{/str}}
            </ion-button>
            <ion-button size="small" color="warning"
                        fill="{{# kechikdi }}solid{{/ kechikdi }}{{^ kechikdi }}outline{{/ kechikdi }}"
                        core-site-plugins-call-ws
                        name="local_targetzenit_mobile_save_record"
                        [params]="{lessonid: {{ lessonid }}, userid: {{ userid }}, attendance: 'late', grade: CONTENT_OTHERDATA.gr_{{ userid }}}"
                        [preSets]="{typeExpected: 'object'}"
                        refreshOnSuccess="true">
                {{#str}}att_late, local_targetzenit{{/str}}
            </ion-button>
            <ion-button size="small" color="medium"
                        fill="{{# sababli }}solid{{/ sababli }}{{^ sababli }}outline{{/ sababli }}"
                        core-site-plugins-call-ws
                        name="local_targetzenit_mobile_save_record"
                        [params]="{lessonid: {{ lessonid }}, userid: {{ userid }}, attendance: 'excused', grade: CONTENT_OTHERDATA.gr_{{ userid }}}"
                        [preSets]="{typeExpected: 'object'}"
                        refreshOnSuccess="true">
                {{#str}}att_excused, local_targetzenit{{/str}}
            </ion-button>
        </div>
    </ion-item>

    <ion-item>
        <ion-label position="stacked">
            {{#str}}grade, local_targetzenit{{/str}} (1–{{ maxgrade }})
        </ion-label>
        <ion-input type="number" min="1" max="{{ maxgrade }}"
                   [(ngModel)]="CONTENT_OTHERDATA.gr_{{ userid }}"
                   name="gr_{{ userid }}"></ion-input>
        <ion-button slot="end" size="small"
                    core-site-plugins-call-ws
                    name="local_targetzenit_mobile_save_record"
                    [params]="{lessonid: {{ lessonid }}, userid: {{ userid }}, attendance: '{{# keldi }}present{{/ keldi }}{{# kelmadi }}absent{{/ kelmadi }}{{# kechikdi }}late{{/ kechikdi }}{{# sababli }}excused{{/ sababli }}', grade: CONTENT_OTHERDATA.gr_{{ userid }}}"
                    [preSets]="{typeExpected: 'object'}"
                    successMessage="{{#str}}app_saved, local_targetzenit{{/str}}"
                    refreshOnSuccess="true">
            {{#str}}app_savegrade, local_targetzenit{{/str}}
        </ion-button>
    </ion-item>
    {{/ oquvchilar }}
</ion-list>
{{/ ruxsat }}
