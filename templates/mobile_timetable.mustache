{{!
    @template local_targetzenit/mobile_timetable

    Dars jadvali — mobil ilova (veb `index.php` ning aksi).

    HAR KUN YIG'ILADIGAN BLOK (<details>), bugungi kun ochiq. Bu filtr
    vazifasini bajaradi: o'qituvchi kerakli kunni bir bosishda ochadi.
    Ustunlar veb bilan bir xil: dars raqami, vaqt, fan, kim/qaysi sinf, xona.

    Context variables required for this template:
    * bor, xabar
    * kunlar - [{nomi, sana, bugun, yopiq, sabab, bor, darslar}]
    * darslar - [{lessonno, vaqt, fan, xona, kim}]

    Example context (json):
    {
        "bor": true, "xabar": "",
        "kunlar": [{"nomi": "Monday", "sana": "03/11/26", "bugun": true,
            "yopiq": false, "sabab": "Term 2", "bor": true,
            "darslar": [{"lessonno": 1, "vaqt": "08:30 – 09:15",
                "fan": "ROBOTICS", "xona": "204", "kim": "8 A(full)"}]}]
    }
}}
{{^ bor }}
    <ion-card><ion-card-content><p>{{ xabar }}</p></ion-card-content></ion-card>
{{/ bor }}

{{# bor }}
{{# kunlar }}
<details {{# bugun }}open{{/ bugun }}
         style="border-bottom:1px solid rgba(0,0,0,.12)">
    <summary style="padding:12px;cursor:pointer;display:flex;justify-content:space-between;gap:8px">
        <span style="font-weight:700">{{ nomi }}</span>
        <span style="font-size:12px;opacity:.7">{{ sana }}</span>
    </summary>

    {{^ bor }}
        <div style="padding:0 12px 12px;font-size:13px;opacity:.7">
            {{# yopiq }}{{ sabab }}{{/ yopiq }}
            {{^ yopiq }}{{#str}}timetable_nolessons, local_targetzenit{{/str}}{{/ yopiq }}
        </div>
    {{/ bor }}

    {{# bor }}
    <div style="overflow-x:auto;width:100%;padding:0 8px 12px">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
            <thead>
                <tr style="text-align:left;opacity:.7;font-size:12px">
                    <th style="padding:4px 6px">#</th>
                    <th style="padding:4px 6px">{{#str}}time{{/str}}</th>
                    <th style="padding:4px 6px">{{#str}}subject, local_targetzenit{{/str}}</th>
                    <th style="padding:4px 6px">{{#str}}room, local_targetzenit{{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{# darslar }}
                <tr style="border-top:1px solid rgba(0,0,0,.06)">
                    <td style="padding:6px;white-space:nowrap">{{ lessonno }}</td>
                    <td style="padding:6px;white-space:nowrap;font-size:12px">{{ vaqt }}</td>
                    <td style="padding:6px">
                        <div style="font-weight:600">{{ fan }}</div>
                        <div style="font-size:12px;opacity:.7">{{ kim }}</div>
                    </td>
                    <td style="padding:6px;white-space:nowrap">{{ xona }}</td>
                </tr>
                {{/ darslar }}
            </tbody>
        </table>
    </div>
    {{/ bor }}
</details>
{{/ kunlar }}
{{/ bor }}
